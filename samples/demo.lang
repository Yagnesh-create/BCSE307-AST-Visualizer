// Team 16 - AST Visualizer demo
func classify(x) {
    if (x < 0) {
        print("negative");
    } else {
        print("non-negative");
    }
}

func main() {
    let a = 5 + 3 * 2;
    int i = 0;
    while (i < 10) {
        i = i + 1;
    }
    for (let j = 0; j < 3; j = j + 1) {
        print(j);
    }
    return classify(a);
}
